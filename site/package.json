{
  "name": "sworn-public-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/prepare.mjs && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "check:abi": "node scripts/check-abi.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "lossless-json": "4.3.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "viem": "2.38.5"
  },
  "devDependencies": {
    "@types/node": "22.18.10",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.1.10"
  }
}
